<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <h1>Todos</h1>
    <ul>
    <% todosPriority.forEach( el => { %>
            <li class='todoItem' data-id='<%=el._id%>'>
                <input type="checkbox" class="check" <%= el.completed ? "checked" : "" %> />
                 <span class='<%= el.completed ? "completed" : "not" %> <%= el.priority ? "priority" : "" %>'>
                <%= el.todo %>
                </span>
                <span class='flag'> 📌 </span>
                <span class='del'> 🗑️ </span>
            </li>
    <% }) %>    

    <% todos.forEach( el => { %>
            <li class='todoItem' data-id='<%=el._id%>'>
                <input type="checkbox" class="check" <%= el.completed ? "checked" : "" %> />
                 <span class='<%= el.completed ? "completed" : "not" %> <%= el.priority ? "priority" : "" %>'>
                <%= el.todo %>
                </span>
                <span class='flag'> 📌 </span>
                <span class='del'> 🗑️ </span>
            </li>
    <% }) %>    
    </ul>

    <h2><%= user.userName %> has <%= left %> things left to do.</h2>

    <form action="/todos/createTodo" method='POST'>
        <input type="text" placeholder="Enter a new Todo Item" name='todoItem'>
        <input type="submit" value="Submit">
    </form>

    <a href="/logout">Logout</a>

    <script src="js/main.js"></script>
</body>
</html>