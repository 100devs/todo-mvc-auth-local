<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Log in — Clear</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="auth-page"><main class="auth-shell"><a class="brand auth-brand" href="/"><span class="brand-mark">✓</span> Clear</a><section class="auth-card"><div class="auth-heading"><p class="eyebrow">Welcome back</p><h1>Log in to Clear</h1><p>Pick up right where you left off.</p></div>
<% if (locals.messages && messages.errors) { %><div class="alert" role="alert"><% messages.errors.forEach(el => { %><p><%= el.msg %></p><% }) %></div><% } %><% if (locals.messages && messages.info) { %><div class="alert" role="alert"><% messages.info.forEach(el => { %><p><%= el.msg %></p><% }) %></div><% } %>
<form class="auth-form" action="/login" method="post"><label for="email">Email</label><input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required autofocus><label for="password">Password</label><input id="password" type="password" name="password" placeholder="Your password" autocomplete="current-password" required><button class="button button-primary button-full" type="submit">Log in</button></form><p class="auth-footer">New to Clear? <a href="/signup">Create an account</a></p></section></main></body></html>
